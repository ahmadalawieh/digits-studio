    "playwright": "^1.63.0",
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "framer-motion": "14.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.34.1"
  },
  "engines": {
    "node": "22.x"
  },
  "type": "module"
}
