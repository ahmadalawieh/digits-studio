{
  "name": "digits-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Digits Studio brand identity and bilingual agency website",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local dev_server.mjs",
    "qa": "node check_site.mjs",
