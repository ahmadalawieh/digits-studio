{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --omit=dev --ignore-scripts",
  "buildCommand": "node build_public_kit.mjs && node validate-production.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/menu-demo/:path*",
      "headers": [{"key":"X-Robots-Tag","value":"noindex, nofollow"}]
    }
  ],
  "redirects": [
    {
      "source": "/hire",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/audit",
      "destination": "/contact",
      "permanent": true
    }
  ],
  "functions": {
    "api/inquiry.js": {
      "maxDuration": 15
    }
  }
}
